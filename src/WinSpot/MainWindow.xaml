<Window x:Class="WinSpot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinSpot"
        Height="640" Width="520"
        MinHeight="480" MinWidth="420"
        Background="#F3F5F7"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
  <Grid>
    <DockPanel Margin="16">
      <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,12,0,0"
                 Foreground="#546E7A" TextWrapping="Wrap" Text="拖动准星到目标窗口以绑定。"/>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- Bind -->
          <GroupBox Header="窗口绑定" Padding="8" Margin="0,0,0,10">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border x:Name="BindCrosshair"
                        Width="36" Height="36" Background="#ECEFF1" BorderBrush="#90A4AE"
                        BorderThickness="1" Cursor="Cross" ToolTip="按住拖到目标窗口"
                        MouseLeftButtonDown="BindCrosshair_MouseLeftButtonDown"
                        MouseMove="BindCrosshair_MouseMove"
                        MouseLeftButtonUp="BindCrosshair_MouseLeftButtonUp">
                  <TextBlock Text="✚" HorizontalAlignment="Center" VerticalAlignment="Center"
                             FontSize="18" Foreground="#37474F"/>
                </Border>
                <Button Content="清除绑定" Margin="12,0,0,0" Padding="10,4" Click="ClearBind_Click"/>
                <Button Content="刷新" Margin="8,0,0,0" Padding="10,4" Click="RefreshBind_Click"/>
              </StackPanel>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                  <RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="句柄"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="HandleText" IsReadOnly="True" Margin="0,2"/>
                <Button Grid.Row="0" Grid.Column="2" Content="复制" Margin="6,2,0,2" Click="CopyHandle_Click"/>

                <TextBlock Grid.Row="1" Text="标题"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TitleText" IsReadOnly="True" Margin="0,2"/>
                <Button Grid.Row="1" Grid.Column="2" Content="复制" Margin="6,2,0,2" Click="CopyTitle_Click"/>

                <TextBlock Grid.Row="2" Text="类名"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ClassText" IsReadOnly="True" Margin="0,2"/>
                <Button Grid.Row="2" Grid.Column="2" Content="复制" Margin="6,2,0,2" Click="CopyClass_Click"/>

                <TextBlock Grid.Row="3" Text="进程"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="ProcessText" IsReadOnly="True" Margin="0,2"/>
                <Button Grid.Row="3" Grid.Column="2" Content="复制" Margin="6,2,0,2" Click="CopyProcess_Click"/>

                <TextBlock Grid.Row="4" Text="客户区大小"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="ClientSizeText" IsReadOnly="True" Margin="0,2"/>
                <Button Grid.Row="4" Grid.Column="2" Content="复制" Margin="6,2,0,2" Click="CopyClientSize_Click"/>

                <TextBlock Grid.Row="5" Text="客户区原点"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="ClientOriginText" IsReadOnly="True" Margin="0,2"/>
                <Button Grid.Row="5" Grid.Column="2" Content="复制" Margin="6,2,0,2" Click="CopyClientOrigin_Click"/>
              </Grid>
            </StackPanel>
          </GroupBox>

          <!-- Modes as tabs (FR-013) -->
          <GroupBox Header="探测模式" Padding="8" Margin="0,0,0,10">
            <TabControl x:Name="ProbeModeTabs" SelectionChanged="ProbeModeTabs_SelectionChanged">
              <TabItem x:Name="TabNone" Header="无">
                <TextBlock Margin="0,10,0,0" Foreground="#607D8B" TextWrapping="Wrap"
                           Text="未启用探测。选择「拾取」或「框选」后，在绑定窗口客户区内操作。"/>
              </TabItem>
              <TabItem x:Name="TabPick" Header="拾取">
                <StackPanel Margin="0,10,0,0">
                  <TextBlock Margin="0,0,0,4" Text="拾取结果"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="PickCoordText" Width="120" IsReadOnly="True"/>
                    <Button Content="复制坐标" Margin="6,0,0,0" Click="CopyPickCoord_Click"/>
                    <TextBox x:Name="PickColorText" Width="100" Margin="12,0,0,0" IsReadOnly="True"/>
                    <Button Content="复制颜色" Margin="6,0,0,0" Click="CopyPickColor_Click"/>
                  </StackPanel>
                  <TextBlock Margin="0,8,0,0" Foreground="#607D8B" TextWrapping="Wrap"
                             Text="提示：在 WinSpot 外点击绑定窗口客户区拾取；窗口内仍可正常操作。Esc 或「无」结束。"/>
                </StackPanel>
              </TabItem>
              <TabItem x:Name="TabMarquee" Header="框选">
                <StackPanel Margin="0,10,0,0">
                  <TextBlock Margin="0,0,0,4" Text="框选结果"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="RegionText" Width="260" IsReadOnly="True"/>
                    <Button Content="复制区域" Margin="6,0,0,0" Click="CopyRegion_Click"/>
                  </StackPanel>
                  <TextBlock Margin="0,8,0,0" Foreground="#607D8B" TextWrapping="Wrap"
                             Text="提示：在 WinSpot 外拖拽框选；拖拽中显示绿色边框。结果格式 x1,y1,x2,y2。Esc 或「无」结束。"/>
                </StackPanel>
              </TabItem>
            </TabControl>
          </GroupBox>

          <!-- Capture -->
          <GroupBox Header="截图设置 (F12)" Padding="8">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <TextBlock Text="保存目录" Width="70" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="浏览…" Margin="6,0,0,0" Padding="8,2" Click="BrowseSaveDir_Click"/>
                <TextBox x:Name="SaveDirText"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,6">
                <TextBlock Text="格式" Width="70" VerticalAlignment="Center"/>
                <ComboBox x:Name="FormatCombo" Width="120" HorizontalAlignment="Left"
                          SelectionChanged="Settings_Changed"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,6">
                <TextBlock Text="JPEG 质量" Width="70" VerticalAlignment="Center"/>
                <Slider x:Name="JpegQualitySlider" Minimum="1" Maximum="100" Width="180"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Settings_Changed"/>
                <TextBlock x:Name="JpegQualityLabel" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </DockPanel>
              <DockPanel Margin="0,0,0,6">
                <TextBlock Text="文件名模板" Width="70" VerticalAlignment="Center"/>
                <TextBox x:Name="FilenameTemplateText" LostFocus="Settings_Changed"/>
              </DockPanel>
              <StackPanel Orientation="Horizontal">
                <Button Content="保存设置" Padding="10,4" Click="SaveSettings_Click"/>
                <Button Content="立即截图" Margin="8,0,0,0" Padding="10,4" Click="CaptureNow_Click"/>
              </StackPanel>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- Top toast for copy feedback (FR-014) -->
    <Border x:Name="CopyToast"
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            Margin="24,12,24,0"
            Padding="14,10"
            Background="#1F2A37"
            CornerRadius="4"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            Panel.ZIndex="100">
      <TextBlock Text="已复制"
                 Foreground="White"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center"/>
    </Border>
  </Grid>
</Window>
